<Window x:Class="anketka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:anketka"
        mc:Ignorable="d"
              Title="Анкета студента" Height="400" Width="400" Background="DarkSeaGreen" >

    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <Border BorderBrush="Red" BorderThickness="2">
                    <AdornedElementPlaceholder/>
                </Border>
                <TextBlock Foreground="Red" FontSize="12"
               Text="{Binding [0].ErrorContent}" />
            </StackPanel>
        </ControlTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style TargetType="Button" x:Key="ButtonRegistration">
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=fio}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=group}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=age}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=cbCourse}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=chkAgree}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Анкета" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="0" FontSize="40" FontWeight="Bold" Grid.ColumnSpan="2" />

        <TextBlock Text="ФИО: " Grid.Column="0" Grid.Row="1" />
        <TextBox x:Name="fio" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding FIO, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="1" Margin="10"/>

        <TextBlock Text="Группа: " Grid.Column="0" Grid.Row="2" />
        <TextBox x:Name="group"  Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="2" Margin="10"/>
        <TextBlock Text="Курс: " Grid.Column="0" Grid.Row="4" />
        <ComboBox x:Name="cbCourse" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Course, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="4" Margin="10"/>

        <TextBlock Text="Возраст:" Grid.Column="0" Grid.Row="3" />
        <TextBox x:Name="age"  Validation.ErrorTemplate="{StaticResource ErrorTemplate}" 
                 Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                 Grid.Column="1" Grid.Row="3" Margin="10"/>

        <CheckBox Grid.Column="0" x:Name="chkAgree" Grid.Row="6" Grid.ColumnSpan="2" Margin="10,16,10,15" FontSize="15">Согласен на обработку персональных данных</CheckBox>

        <Button Content="Сохранить" Style="{StaticResource ButtonRegistration}" Height="30" Click="Reg_Click" Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" Margin="10,10,10,10"/>


    </Grid>
</Window>
